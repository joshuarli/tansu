{
  "name": "tansu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "make dev",
    "build": "node scripts/build-web.mjs production",
    "build:dev": "node scripts/build-web.mjs development",
    "lint": "oxlint --config oxlint.config.mjs",
    "typecheck": "pnpm run loupe:wasm && tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:browser": "TANSU_LOGS=buffer pnpm run build:dev && PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-.work/tmp/playwright-browsers} vitest run --config vitest.e2e.config.ts",
    "loupe:wasm": "node scripts/build-defuddle-wasm.mjs",
    "loupe:build": "pnpm run loupe:wasm && NODE_ENV=development node scripts/build-loupe.mjs",
    "loupe:dist": "pnpm run loupe:wasm && NODE_ENV=production node scripts/build-loupe.mjs",
    "loupe:browser": "node scripts/build-browser-test-bundles.mjs && PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-.work/tmp/playwright-browsers} vitest run --config vitest.loupe-browser.config.ts",
    "loupe:reader-sample": "node scripts/build-reader-sample-fixture.mjs",
    "playwright:install": "node scripts/install-playwright-browsers.mjs",
    "types": "pnpm run build && cargo run --quiet -p gen-api-types",
    "types:check": "pnpm run build && cargo run --quiet -p gen-api-types -- --check",
    "test:rs": "pnpm run build && cargo test -q --workspace",
    "test:app-interleavings": "vitest run web/ts/app.test.ts -t interleavings",
    "test:acceptance": "pnpm run test:app-interleavings && pnpm run test:browser -- -t acceptance:",
    "test:e2e:chromium": "TANSU_E2E_BROWSER=chromium pnpm run test:browser",
    "test:e2e:webkit": "TANSU_E2E_BROWSER=webkit pnpm run test:browser",
    "test:e2e:loupe": "pnpm run loupe:build && pnpm run build:dev && PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-.work/tmp/playwright-browsers} vitest run --config vitest.loupe.config.ts",
    "check": "pnpm run types:check && pnpm run lint && pnpm run typecheck && pnpm run test && cargo check -q"
  },
  "playwrightBrowsers": {
    "playwrightVersion": "1.64.0",
    "install": [
      "chromium",
      "webkit"
    ],
    "browsers": {
      "chromium": {
        "version": "156.0.8078.4",
        "revision": "1248"
      },
      "webkit": {
        "version": "27.2",
        "revision": "2370",
        "revisionOverrides": {
          "mac14": "2251",
          "mac14-arm64": "2251"
        }
      }
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.0.5",
    "effect": "4.1.0",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
