#!/sbin/openrc-run

name="tansu"
description="Tansu note server"

if [ -r /etc/tansu/stats.env ]; then
  . /etc/tansu/stats.env
fi

: "${TANSU_PORT:=3001}"
: "${TANSU_HOME:=/var/lib/tansu}"
if [ -z "${TANSU_RELEASE:-}" ]; then
  TANSU_RELEASE=$(basename "$(readlink /opt/tansu/current 2>/dev/null || true)")
fi
export TANSU_RELEASE
export TANSU_STATS_ENDPOINT TANSU_STATS_TOKEN TANSU_STATS_SERVICE TANSU_STATS_RELEASE TANSU_STATS_INSTANCE TANSU_STATS_HOST

export HOME="$TANSU_HOME"
export XDG_CONFIG_HOME="$TANSU_HOME/config"
export XDG_DATA_HOME="$TANSU_HOME/data"

command="/opt/tansu/current/tansu"
command_args="--port $TANSU_PORT"
command_user="tansu:tansu"
directory="$TANSU_HOME"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=0
output_log="/var/log/tansu/tansu.log"
error_log="/var/log/tansu/tansu.err"

depend() {
  need net
  after tailscaled
}

start_pre() {
  checkpath --directory --owner root:tansu --mode 0750 "$TANSU_HOME"
  checkpath --directory --owner tansu:tansu --mode 0750 "$TANSU_HOME/config" "$TANSU_HOME/data" "/var/log/tansu"
  test -x /opt/tansu/current/tansu
}
